# Copy to .env.local and fill in with values from your Supabase project
# (Project Settings -> API). Never commit .env.local.

# Public — safe to expose in the browser bundle. Used by
# src/lib/supabase/client.ts and src/lib/supabase/server.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only, bypasses Row Level Security. Used by
# createSupabaseServiceRoleClient() in src/lib/supabase/server.ts. Never
# prefix this with NEXT_PUBLIC_ and never reference it from a Client
# Component.
SUPABASE_SERVICE_ROLE_KEY=

# Outgoing email (appointment admin notification + patient confirmation).
# Used by src/lib/email/transporter.ts. If any of these are unset, email
# sending is silently skipped — the appointment is still saved either way.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=help@pinkcityhealthcare.com
SMTP_PASS=PinkCity@#1718HealthCare
EMAIL_FROM=help@pinkcityhealthcare.com
